# ─────────────────────────────────────────────────────────────
# Al-Izdehar Logistics — Environment Template
# Copy to `.env.local` and fill in your own values.
# ─────────────────────────────────────────────────────────────

# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL="https://www.your-domain.com"

# Default / fallback locale: "en" | "ar"
NEXT_PUBLIC_DEFAULT_LOCALE="en"

# ── Supabase ────────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Project Settings → API → service_role (SERVER ONLY — never exposed to client)
SUPABASE_SERVICE_ROLE_KEY=""

# ── Optional integrations ───────────────────────────────────
# Leave empty to disable. Loaded only when set (see src/lib/settings.ts).
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_GTM_ID=""
